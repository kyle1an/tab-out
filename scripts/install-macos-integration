#!/bin/zsh

set -euo pipefail

usage() {
  printf '%s\n' \
    "Usage: scripts/install-macos-integration <32-character-extension-id> [hammerspoon-config-directory]"
  printf '%s\n' \
    "The config directory defaults to TAB_OUT_HAMMERSPOON_CONFIG_DIR or ~/.hammerspoon."
}

if (( $# == 1 )) && [[ $1 == "-h" || $1 == "--help" ]]; then
  usage
  exit 0
fi

if (( $# < 1 || $# > 2 )) || [[ ! $1 =~ '^[a-p]{32}$' ]]; then
  usage >&2
  exit 64
fi

script_directory=${0:A:h}
extension_id=$1
config_directory=${2:-${TAB_OUT_HAMMERSPOON_CONFIG_DIR:-"$HOME/.hammerspoon"}}

"$script_directory/hammerspoon/build" >/dev/null
"$script_directory/hammerspoon/install" "$config_directory"
"$script_directory/native-host/install" "$extension_id"

printf '%s\n' "Reload Tab Out in chrome://extensions, then reload Hammerspoon."
