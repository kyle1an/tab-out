#!/bin/zsh

set -euo pipefail

script_directory=${0:A:h}
repository_root=${script_directory:h:h}
spoon_directory="$repository_root/integrations/hammerspoon/TabOut.spoon"
source_file="$spoon_directory/native/tab_out_private_focus.m"
output_directory="$spoon_directory/native/build"
output_file="$output_directory/tab_out_private_focus.dylib"

mkdir -p "$output_directory"
temporary_directory=$(mktemp -d "$output_directory/.tab_out_private_focus.XXXXXX")
temporary_output="$temporary_directory/tab_out_private_focus.dylib"

cleanup() {
  rm -f "$temporary_output"
  rmdir "$temporary_directory" 2>/dev/null || true
}

trap cleanup EXIT

xcrun clang \
  -fobjc-arc \
  -fblocks \
  -Wall \
  -Wextra \
  -Werror \
  -O2 \
  -mmacosx-version-min=13.0 \
  -dynamiclib \
  -fvisibility=hidden \
  -F/Applications/Hammerspoon.app/Contents/Frameworks \
  -I/Applications/Hammerspoon.app/Contents/Frameworks/LuaSkin.framework/Headers \
  "$source_file" \
  -framework LuaSkin \
  -framework Cocoa \
  -framework ApplicationServices \
  -framework ScriptingBridge \
  -ldl \
  -o "$temporary_output"

mv -f "$temporary_output" "$output_file"
rmdir "$temporary_directory"
trap - EXIT

printf '%s\n' "$output_file"
