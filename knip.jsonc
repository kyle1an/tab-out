{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Exports tagged /** @public */ are deliberate surface (seam barrels per
  // ADR-0002, Base UI family exports) — excluded from unused-export reports.
  "tags": ["-public"],
  "entry": [
    "src/app.tsx",
    "src/extension/background.ts",
    "src/extension/dashboard-view-boot.ts",
    "src/extension/filter-focus-boot.ts",
    "src/styles/app.css",
    "tests/**/*.test.ts",
    "tests/browser/**/*.spec.ts",
    "tests/extension/working-set-storage-benchmark-background.ts",
    "tests/extension/working-set-backends/*.ts",
    "tests/helpers/fake-chrome.mjs",
    "scripts/*.ts"
  ],
  "project": ["src/**/*.{css,ts,tsx}", "scripts/**/*.ts", "tests/**/*.{ts,mjs}"],
  "ignoreIssues": {
    // Shared UI primitives intentionally preserve the upstream-supported
    // component family even when current product callers use only a subset.
    "src/components/ui/dialog.tsx": ["exports"],
    "src/components/ui/select.tsx": ["exports"]
  },
  "ignoreDependencies": [
    // Icon sets are consumed by @iconify/tailwind4 through CSS class names
    // (icon-[lucide--…] etc.) in src/styles/app.css — invisible to knip.
    "@iconify-json/lucide",
    "@iconify-json/mingcute",
    "@iconify-json/ooui",
    "@iconify-json/weui",
    // Scaffolding CLI driven by components.json, run ad hoc — never imported.
    "shadcn"
  ]
}
