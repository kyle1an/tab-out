{
  "name": "tab-out",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:hooks": "git config core.hooksPath .githooks",
    "dev": "vite build --watch",
    "build": "vite build",
    "build:debug": "vite build --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify:bundle": "git diff --exit-code -- extension/dist",
    "verify": "npm run typecheck && npm run build && npm run verify:bundle && npm test"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/chrome": "^0.1.40",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}
